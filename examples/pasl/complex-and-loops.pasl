// PASL example: loops + complex numbers
// Compile: php pasm-run.php -o complex.pbc examples/pasl/complex-and-loops.pasl
// Run:     php pasm-run.php --print complex.pbc
// Uses exactly eight hot registers: sum + counter + three complex pairs.

$sum = 0;
$counter = 5;
while ($counter) {
    $sum = $sum + $counter;
    $counter--;
}

for ($counter = 0; $counter != 4; $counter++) {
    $sum = $sum + 1;
}

complex $z = 3+4i;
complex $w = 1-2i;
complex $p;
$p = $z * $w;

$counter = 2;
select ($counter) {
    case 1:
        $sum = $sum + 100;
    case 2:
        $sum = $sum + 4;
    default:
        $sum = $sum + 999;
}
