{
  "version": 3,
  "source_dir": "plugins",
  "description": "Context-free JX plugin packages. Each package installs independently and may be linked at Book or library scope.",
  "required_targets": ["windows", "mac", "linux", "web"],
  "target_policy": "A plugin is allowed only if it declares and passes compile checks for windows, mac, linux, and web (jx). Missing any target blocks install.",
  "plugins": [
    {
      "id": "core",
      "name": "jx Core",
      "path": "core",
      "required": true,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["Bag", "Task", "Page", "Book", "RefSign", "Sym"]
    },
    {
      "id": "decimals",
      "name": "Decimals",
      "path": "decimals",
      "required": true,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["Decimal", "decimal arithmetic"]
    },
    {
      "id": "complex",
      "name": "Complex Numbers",
      "path": "complex",
      "required": true,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["Complex"]
    },
    {
      "id": "delivery",
      "name": "Delivery",
      "path": "delivery",
      "required": true,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["Delivery"]
    },
    {
      "id": "smart-compiler",
      "name": "Smart Compiler Table",
      "path": "smart-compiler",
      "required": true,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["SmartTable", "extrude", "Resistant"]
    },
    {
      "id": "const",
      "name": "Const",
      "path": "const",
      "required": true,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["const", "ConstBox"]
    },
    {
      "id": "lang",
      "name": "Language Engine Bridge",
      "path": "lang",
      "required": true,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["JxEngine", "jx-run"]
    },
    {
      "id": "intro",
      "name": "Introduction Materials",
      "path": "intro",
      "required": false,
      "targets": ["windows", "mac", "linux", "web"],
      "provides": ["docs", "examples"]
    }
  ]
}
